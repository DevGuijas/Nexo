root = true

[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{xaml,xml,csproj,props,targets}]
indent_size = 2

[*.{md,yml,yaml}]
indent_size = 2

# Scripts rodados por -File no PowerShell 5.1: com acento, só funcionam com BOM (os .ps1 embutidos do Nexo.Support ficam sem).
[{scripts/*.ps1,Nexo.Checks/*.ps1}]
charset = utf-8-bom
