<Window x:Class="Nexo.Support.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Nexo • Suporte inteligente" Width="1380" Height="900" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource Bg}">
  <Grid x:Name="LoginView">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#111722" Padding="64"><Grid>
    <StackPanel VerticalAlignment="Top"><TextBlock Text="✦  nexo" FontSize="32" FontWeight="Bold"/><TextBlock Text="SUPORTE QUE CONECTA." Foreground="#8CAEFF" FontSize="11" Margin="0,14,0,0"/></StackPanel>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Menos chamados.&#10;Mais soluções." FontFamily="Georgia" FontSize="48" LineHeight="58"/><TextBlock Text="Seu próximo passo começa com uma conversa." Foreground="#A3AEC1" FontSize="18" Margin="0,26,0,40"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="✦  Um parceiro para o seu dia a dia" FontWeight="SemiBold"/><TextBlock Text="Descreva o problema. Acompanhe o diagnóstico.&#10;Resolva com orientação, no seu ritmo." Foreground="#939CAA" Margin="0,12,0,0" LineHeight="24"/></StackPanel></Border></StackPanel>
    <TextBlock Text="WINDOWS  /  DIAGNÓSTICO LOCAL  /  IA OPCIONAL" Foreground="#6D7C94" FontSize="10" VerticalAlignment="Bottom"/>
   </Grid></Border>
   <StackPanel Grid.Column="1" Width="350" VerticalAlignment="Center">
    <TextBlock Text="BEM-VINDO AO NEXO" Foreground="#8CAEFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Vamos resolver juntos." FontFamily="Georgia" FontSize="30"/>
    <TextBlock Text="Entre na sua conta para começar um atendimento." Foreground="#939CAA" Margin="0,12,0,32"/>
    <TextBlock Text="Usuário" Margin="0,0,0,8"/><TextBox x:Name="LoginName" AutomationProperties.Name="Usuário"/>
    <TextBlock Text="Senha" Margin="0,20,0,8"/><PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Senha" KeyDown="LoginKeyDown"/>
    <TextBlock x:Name="LoginError" Foreground="#FFAAAB" Margin="0,14,0,0"/>
    <Button Content="Entrar  →" Style="{StaticResource Primary}" Click="LoginClick" Margin="0,18,0,0" HorizontalContentAlignment="Center"/>
    <TextBlock Text="Esqueceu a senha? Solicite a redefinição a um administrador da sua organização." Foreground="#939CAA" FontSize="12" Margin="0,22,0,0"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="Shell" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#101318" BorderBrush="#252A33" BorderThickness="0,0,1,0">
    <DockPanel Margin="16,26,16,18">
     <StackPanel DockPanel.Dock="Top" Margin="12,0,0,35"><TextBlock Text="✦  nexo" FontWeight="Bold" FontSize="28"/><TextBlock Text="Seu parceiro de TI" Foreground="#939CAA" FontSize="12" Margin="1,6,0,0"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock Text="●  No seu computador" Foreground="#92D7BA" FontSize="12"/><TextBlock Text="Você acompanha cada etapa do atendimento." Foreground="#939CAA" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
      <Button x:Name="ProfileNav" Click="ProfileClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock x:Name="SidebarName" FontWeight="SemiBold"/><TextBlock x:Name="SidebarRole" Foreground="#939CAA" FontSize="11" Margin="0,3,0,0"/></StackPanel></Button>
      <Button Content="↪   Sair da conta" Click="LogoutClick" Foreground="#AAAFC0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,8,0,0"/>
     </StackPanel>
     <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation">
      <TextBlock Text="ESPAÇO DE TRABALHO" FontSize="10" Foreground="#707B8C" Margin="12,0,0,14"/>
      <Button x:Name="ChatNav" Tag="chat" Click="NavigateClick" HorizontalContentAlignment="Left" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Width="20" TextAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Assistente"/></StackPanel></Button>
      <Button Tag="history" Click="NavigateClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="20" TextAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Atendimentos"/></StackPanel></Button>
      <Button Tag="tickets" Click="NavigateClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="20" TextAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Encaminhamentos"/></StackPanel></Button>
      <TextBlock x:Name="AdminLabel" Text="ADMINISTRAÇÃO" FontSize="10" Foreground="#707B8C" Margin="12,32,0,14"/>
      <Button x:Name="UsersNav" Tag="users" Click="NavigateClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="♙" Width="20" TextAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Usuários e acessos"/></StackPanel></Button>
      <Button x:Name="SettingsNav" Tag="settings" Click="NavigateClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Configurações"/></StackPanel></Button>
      <Button x:Name="AuditNav" Tag="audit" Click="NavigateClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal"><TextBlock Text="☷" Width="20" TextAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Registro de ações"/></StackPanel></Button>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#252A33" BorderThickness="0,0,0,1" Padding="32,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="SUPORTE INTELIGENTE" Foreground="#7D8798" FontSize="10" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBlock x:Name="ModeBadge" Text="●  Diagnóstico local" Foreground="#92D7BA" HorizontalAlignment="Right" FontSize="12"/></DockPanel></Border>
    <Grid Grid.Row="1" Margin="34,26,34,24">
     <Grid x:Name="ChatView">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22"><Button Content="＋  Novo atendimento" Click="NewChatClick" DockPanel.Dock="Right" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Assistente" FontFamily="Georgia" FontSize="28"/><TextBlock Text="Um problema a menos no seu dia." Foreground="#939CAA" Margin="0,7,0,0"/></StackPanel></DockPanel>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
       <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,22,0"><StackPanel x:Name="Messages">
       </StackPanel></ScrollViewer>
       <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="19"><Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="NESTE ATENDIMENTO" FontSize="10" Foreground="#939CAA"/><TextBlock Text="Cada etapa, às claras." FontSize="16" FontWeight="SemiBold" Margin="0,15,0,14"/></StackPanel>
         <ScrollViewer x:Name="ProgressScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ProgressText" Text="Pronto para ouvir você.&#10;&#10;As verificações e seus resultados aparecerão aqui." Foreground="#A4AFC2" LineHeight="23" Margin="0,0,7,0"/></ScrollViewer>
         <ProgressBar x:Name="BusyBar" Grid.Row="2" IsIndeterminate="True" Height="3" Foreground="#8CAEFF" Background="#252D3B" Visibility="Collapsed" Margin="0,18,0,0"/>
         <Button x:Name="CancelButton" Grid.Row="3" Content="Cancelar verificação" Click="CancelClick" Visibility="Collapsed" Margin="0,14,0,0"/>
        </Grid></Border>
        <Border x:Name="ControlHint" Grid.Row="1" Style="{StaticResource Card}" Padding="19" Margin="0,14,0,0"><StackPanel><TextBlock Text="Você no controle" FontWeight="SemiBold"/><TextBlock Text="O diagnóstico consulta o Windows. Antes de uma correção, você vê e autoriza a ação." Foreground="#939CAA" FontSize="12" Margin="0,10,0,0" LineHeight="20"/></StackPanel></Border>
        <Button x:Name="ResolvedButton" Grid.Row="2" Content="✓  Meu problema foi resolvido" Click="ResolvedClick" Margin="0,18,0,0" FontSize="12"/>
        <Button x:Name="TicketButton" Grid.Row="3" Content="Encaminhar para a TI  ↗" Click="EscalateClick" Background="Transparent" BorderThickness="0" Foreground="#939CAA" Margin="0,6,0,0" FontSize="12"/>
       </Grid>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,18,272,0">
       <Border Background="#161B23" BorderBrush="#384459" BorderThickness="1" CornerRadius="12" Padding="14"><DockPanel><Button x:Name="SendButton" Content="↑" Style="{StaticResource Primary}" Click="SendClick" DockPanel.Dock="Right" Width="42" Height="42" Padding="0" HorizontalContentAlignment="Center"/><TextBox x:Name="Composer" AutomationProperties.Name="Descreva seu problema" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="6000" MinHeight="42" MaxHeight="110" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" PreviewKeyDown="ComposerKeyDown" ToolTip="Descreva seu problema. Shift + Enter envia; Enter insere uma linha."/></DockPanel></Border>
       <TextBlock Text="Descreva o que aconteceu • Shift + Enter para enviar • Enter para nova linha" Foreground="#748095" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      </StackPanel>
     </Grid>
     <ScrollViewer x:Name="PageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent" MaxWidth="940" HorizontalAlignment="Stretch"/></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
