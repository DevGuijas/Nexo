<Application x:Class="Nexo.Support.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
 <ResourceDictionary>
  <!-- Paleta (#143): Themes/Onyx.xaml é o padrão; o ThemeManager troca o dicionário em tempo real. Por isso as cores usam
       DynamicResource; estilos, fontes e geometrias continuam StaticResource. -->
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Onyx.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Fontes embutidas (ThirdParty/Fonts, OFL 1.1). -->
  <FontFamily x:Key="BodyFont">pack://application:,,,/Nexo;component/Fonts/#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Nexo;component/Fonts/#Barlow Condensed</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Nexo;component/Fonts/#IBM Plex Mono</FontFamily>
  <!-- Logo (#143), em grade 24×24: diagonal secundária fina (LogoSoft) por baixo e diagonal principal (LogoStrong), uma barra
       arredondada com vão interno, por cima; cada diagonal tem um nó em cada ponta. UiIcons.Logo usa as mesmas geometrias. -->
  <LineGeometry x:Key="LogoSoftLine" StartPoint="6.9,17.1" EndPoint="17.1,6.9"/>
  <GeometryGroup x:Key="LogoSoftNodes"><EllipseGeometry Center="18.4,5.6" RadiusX="3" RadiusY="3"/><EllipseGeometry Center="5.6,18.4" RadiusX="3" RadiusY="3"/></GeometryGroup>
  <GeometryGroup x:Key="LogoStrongNodes"><EllipseGeometry Center="5.6,5.6" RadiusX="3.3" RadiusY="3.3"/><EllipseGeometry Center="18.4,18.4" RadiusX="3.3" RadiusY="3.3"/></GeometryGroup>
  <GeometryGroup x:Key="LogoStrongBar" FillRule="EvenOdd">
   <RectangleGeometry Rect="3.8,9.9,16.4,4.2" RadiusX="2.1" RadiusY="2.1"><RectangleGeometry.Transform><RotateTransform Angle="45" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
   <RectangleGeometry Rect="6.6,11.35,10.8,1.3" RadiusX="0.65" RadiusY="0.65"><RectangleGeometry.Transform><RotateTransform Angle="45" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
  </GeometryGroup>

  <Style TargetType="Window">
   <Setter Property="Background" Value="{DynamicResource CanvasBg}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
   <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
   <!-- Linhas retas nítidas sem SnapsToDevicePixels, que serrilha as curvas das bordas arredondadas (#143). -->
   <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="30"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><Border x:Name="FocusRing" Margin="-3" BorderThickness="2" CornerRadius="11" BorderBrush="{DynamicResource Accent}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/></Trigger></Style.Triggers>
  </Style>
  <!-- Botões de ação (#143): cantos de 8 px e borda de 1 px; o foco de teclado é um anel externo de 2 px na cor do texto (fora do
       botão, sem mudar a espessura da borda nem empurrar o conteúdo); pressionado distinto do repouso e do hover. SecondaryAction tem
       contorno; Primary é dourado e escurece (AccentPressed) ao pressionar. Sem animação: os estados trocam direto. -->
  <ControlTemplate x:Key="ActionTemplate" TargetType="Button"><Grid><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><Border x:Name="FocusRing" Margin="-3" BorderThickness="2" CornerRadius="11" BorderBrush="{DynamicResource Ink}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
  <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Template" Value="{StaticResource ActionTemplate}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/><Setter Property="Padding" Value="14,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource SecondaryAction}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentHover}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPressed}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}"/></Trigger></Style.Triggers></Style>
  <!-- Atalho "Resolver rápido" da Início: cartão compacto; hover e pressionado só trocam a borda para o acento. -->
  <Style x:Key="QuickTile" TargetType="Button" BasedOn="{StaticResource SecondaryAction}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
  <!-- Cartões numerados das Ferramentas (#143): mesmo molde dos botões de ação; hover com borda de 1 px no acento e fundo AccentSoft,
       recortado no canto arredondado pelo ToolCard. -->
  <Style x:Key="ToolCardButton" TargetType="Button" BasedOn="{StaticResource SecondaryAction}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="Padding" Value="0"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Secondary}"/><Setter Property="Padding" Value="12,11"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource Surface}" VerticalAlignment="Center">
      <Path x:Name="Tick" Data="M3,8 L6.5,11.5 13,4" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="2" Stretch="Uniform"/>
     </Border>
     <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
 </ResourceDictionary>
 </Application.Resources>
</Application>
