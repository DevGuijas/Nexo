<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nexo</AssemblyName>
    <Version>1.7.0</Version>
    <Product>Nexo</Product>
    <Description>Agente local de suporte para Windows com monitoramento de saúde e recuperação supervisionada.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="NetworkTransaction.ps1" LogicalName="Nexo.NetworkTransaction.ps1" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="NetworkInventory.ps1" LogicalName="Nexo.NetworkInventory.ps1" /><EmbeddedResource Include="EnableNetworkAdapter.ps1" LogicalName="Nexo.EnableNetworkAdapter.ps1" /></ItemGroup>
  <ItemGroup><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" /><PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" /></ItemGroup>
  <ItemGroup><None Update="ThirdParty/LibreHardwareMonitor/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Using Remove="System.Drawing" /><Using Remove="System.Windows.Forms" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/nexo-tray.ico" LogicalName="Nexo.Tray.ico" /></ItemGroup>
</Project>
