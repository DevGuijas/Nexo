<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nexo</AssemblyName>
    <Version>1.7.1</Version>
    <Product>Nexo</Product>
    <Description>Agente local de suporte para Windows com monitoramento de saúde e recuperação supervisionada.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- #142, P9: Main próprio (Program.cs), para o leitor de sensores do sistema (modo sensor-loop) restringir a busca de DLLs antes de o WPF carregar. -->
    <StartupObject>Nexo.Support.Program</StartupObject>
    <!-- Ícone do Nexo (#143): o mesmo arquivo vai no .exe e no atalho (ApplicationIcon), na janela (Resource) e na bandeja. -->
    <ApplicationIcon>Assets\nexo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="NetworkTransaction.ps1" LogicalName="Nexo.NetworkTransaction.ps1" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="NetworkInventory.ps1" LogicalName="Nexo.NetworkInventory.ps1" /><EmbeddedResource Include="EnableNetworkAdapter.ps1" LogicalName="Nexo.EnableNetworkAdapter.ps1" /></ItemGroup>
  <ItemGroup><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" /><PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" /></ItemGroup>
  <ItemGroup><None Update="ThirdParty/LibreHardwareMonitor/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Using Remove="System.Drawing" /><Using Remove="System.Windows.Forms" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/nexo.ico" LogicalName="Nexo.Tray.ico" /><Resource Include="Assets/nexo.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Fonts/*.ttf" /><None Update="ThirdParty/Fonts/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
